# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Universal Assessment Pro"

# ─── Authentication ────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
AUTH_SECRET=

# ─── Database ─────────────────────────────────────────────────────────────────
# For local Docker: postgresql://uap_user:uap_secret@localhost:5432/universal_assessment_pro
DATABASE_URL="postgresql://uap_user:uap_secret@localhost:5432/universal_assessment_pro?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
# For local Docker: redis://:uap_redis_secret@localhost:6379
REDIS_URL="redis://:uap_redis_secret@localhost:6379"

# ─── Email (Magic Link / Transactional) ───────────────────────────────────────
EMAIL_SERVER_HOST=smtp.universalbank.uz
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=noreply@universalbank.uz
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Universal Assessment Pro <noreply@universalbank.uz>"

# Optional: Resend API (alternative to SMTP)
# RESEND_API_KEY=

# ─── AI APIs ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── File Storage (optional, for PDFs / images) ───────────────────────────────
# STORAGE_PROVIDER=local  # or "s3"
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# ─── Feature Flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_PROCTORING=true
NEXT_PUBLIC_ENABLE_AI_ADAPTIVE=true
NEXT_PUBLIC_ENABLE_CERTIFICATES=true
